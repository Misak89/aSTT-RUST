digraph "view.docs_generation_stale_check" {
  rankdir=LR;
  graph [bgcolor="#FFFFFF", compound="true", concentrate="true", fontname="Arial", forcelabels="true", label="Docs generation + stale-check", labeljust="l", labelloc="t", newrank="true", nodesep="0.5", ordering="out", outputorder="edgesfirst", overlap="false", pad="0.25", ranksep="0.8", splines="polyline", tooltip="Focused control-doc and diagram generation path, stale-check gates, docs-quality sequence, and non-blocking backlog reports."];
  node [color="#6B7280", fillcolor="#FFFFFF", fontcolor="#111827", fontname="Arial", fontsize="10", margin="0.10,0.06", penwidth="1.2", shape="box", style="rounded,filled"];
  edge [arrowsize="0.7", color="#64748B", fontcolor="#475569", fontname="Arial", fontsize="9", penwidth="1.1"];
  subgraph cluster_actors {
    graph [color="#CBD5E1", fillcolor="#F8FAFC", fontcolor="#334155", fontsize="12", label="Actors", style="rounded,filled"];
    rank="same";
    "actor.user" [class="actor kind- human domain-update domain-manual_review", color="#64748B", fillcolor="#F8FAFC", fontcolor="#0F172A", id="actor.user", label="User", margin="0.12,0.07", penwidth="1.4", shape="hexagon", style="filled", tooltip="User [actor.user]"];
  }
  subgraph cluster_nodes_orchestration_and_guards {
    graph [color="#BFDBFE", fillcolor="#EFF6FF", fontcolor="#334155", fontsize="12", label="Orchestration + Guards", style="rounded,filled"];
    "node.verify_fast_orchestrator" [class="node kind-script bucket-orchestration_and_guards blocking-blocking domain-validate domain-lint domain-test", color="#1D4ED8", fillcolor="#E8F1FF", fontcolor="#1E3A8A", id="node.verify_fast_orchestrator", label="verify_fast / verify_stage", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="verify_fast / verify_stage [node.verify_fast_orchestrator] | kind=script | blocking=blocking | tags= | lint,test,validate"];
    "node.validate_next_session" [class="node kind-validator bucket-orchestration_and_guards blocking-blocking domain-validate domain-manual_review domain-evidence", color="#1D4ED8", fillcolor="#E8F1FF", fontcolor="#1E3A8A", id="node.validate_next_session", label="validate_next_session\nJSON-first", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="validate_next_session JSON-first [node.validate_next_session] | kind=validator | blocking=blocking | tags= | evidence,manual_review,validate"];
    "node.stale_check_control_docs" [class="node kind-gate bucket-orchestration_and_guards blocking-blocking domain-generate domain-validate", color="#0F766E", fillcolor="#E6FFFB", fontcolor="#134E4A", id="node.stale_check_control_docs", label="stale-check control docs", penwidth="1.9", peripheries="2", shape="octagon", style="rounded,filled", tooltip="stale-check control docs [node.stale_check_control_docs] | kind=gate | blocking=blocking | tags= | generate,validate"];
    "node.mkdocs_strict" [class="node kind-validator bucket-orchestration_and_guards blocking-blocking domain-docs_publish domain-validate", color="#6D28D9", fillcolor="#F5F3FF", fontcolor="#4C1D95", id="node.mkdocs_strict", label="mkdocs build --strict", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="mkdocs build --strict [node.mkdocs_strict] | kind=validator | blocking=blocking | tags= | docs_publish,validate"];
    "node.enforce_next_session_flow" [class="node kind-gate bucket-orchestration_and_guards blocking-blocking domain-validate domain-manual_review domain-evidence", color="#1D4ED8", fillcolor="#E8F1FF", fontcolor="#1E3A8A", id="node.enforce_next_session_flow", label="enforce_next_session_flow", penwidth="1.9", peripheries="2", shape="octagon", style="rounded,filled", tooltip="enforce_next_session_flow [node.enforce_next_session_flow] | kind=gate | blocking=blocking | tags= | evidence,manual_review,validate"];
    "node.workflow_control_diagrams_stale_check" [class="node kind-gate bucket-orchestration_and_guards blocking-blocking domain-generate domain-validate domain-docs_publish", color="#6D28D9", fillcolor="#F5F3FF", fontcolor="#4C1D95", id="node.workflow_control_diagrams_stale_check", label="workflow_control_diagrams\nstale-check", penwidth="1.9", peripheries="2", shape="octagon", style="rounded,filled", tooltip="workflow_control_diagrams stale-check [node.workflow_control_diagrams_stale_check] | kind=gate | blocking=blocking | tags= | docs_publish,generate,validate"];
  }
  subgraph cluster_nodes_generators_extractors {
    graph [color="#99F6E4", fillcolor="#F0FDFA", fontcolor="#334155", fontsize="12", label="Generators + Extractors", style="rounded,filled"];
    "node.generate_control_docs" [class="node kind-generator bucket-generators_extractors blocking-blocking domain-generate domain-docs_publish domain-validate", color="#6D28D9", fillcolor="#F5F3FF", fontcolor="#4C1D95", id="node.generate_control_docs", label="generate_control_docs", penwidth="1.9", peripheries="2", shape="component", style="rounded,filled", tooltip="generate_control_docs [node.generate_control_docs] | kind=generator | blocking=blocking | tags= | docs_publish,generate,validate"];
    "node.workflow_control_diagrams_generator" [class="node kind-generator bucket-generators_extractors blocking-blocking domain-generate domain-docs_publish domain-validate", color="#6D28D9", fillcolor="#F5F3FF", fontcolor="#4C1D95", id="node.workflow_control_diagrams_generator", label="generate_workflow_control_diagrams", penwidth="1.9", peripheries="2", shape="component", style="rounded,filled", tooltip="generate_workflow_control_diagrams [node.workflow_control_diagrams_generator] | kind=generator | blocking=blocking | tags= | docs_publish,generate,validate"];
  }
  subgraph cluster_nodes_quality_checks {
    graph [color="#FDE68A", fillcolor="#FFFBEB", fontcolor="#334155", fontsize="12", label="Quality Checks", style="rounded,filled"];
    "node.markdownlint_backlog" [class="node kind-linter bucket-quality_checks blocking-non_blocking domain-lint domain-exceptions_non_blocking domain-evidence", color="#B45309", fillcolor="#FFF7E6", fontcolor="#7C2D12", id="node.markdownlint_backlog", label="markdownlint backlog", penwidth="1.1", peripheries="1", shape="box", style="rounded,filled", tooltip="markdownlint backlog [node.markdownlint_backlog] | kind=linter | blocking=non_blocking | tags= | evidence,exceptions_non_blocking,lint"];
    "node.markdownlint_blocking" [class="node kind-linter bucket-quality_checks blocking-blocking domain-lint domain-docs_publish domain-validate", color="#B45309", fillcolor="#FFF7E6", fontcolor="#7C2D12", id="node.markdownlint_blocking", label="markdownlint blocking", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="markdownlint blocking [node.markdownlint_blocking] | kind=linter | blocking=blocking | tags= | docs_publish,lint,validate"];
    "node.vale_blocking" [class="node kind-linter bucket-quality_checks blocking-blocking domain-lint domain-docs_publish", color="#B45309", fillcolor="#FFF7E6", fontcolor="#7C2D12", id="node.vale_blocking", label="Vale blocking", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="Vale blocking [node.vale_blocking] | kind=linter | blocking=blocking | tags= | docs_publish,lint"];
    "node.vale_backlog" [class="node kind-linter bucket-quality_checks blocking-non_blocking domain-lint domain-exceptions_non_blocking domain-evidence", color="#B45309", fillcolor="#FFF7E6", fontcolor="#7C2D12", id="node.vale_backlog", label="Vale backlog no-regression", penwidth="1.1", peripheries="1", shape="box", style="rounded,filled", tooltip="Vale backlog no-regression [node.vale_backlog] | kind=linter | blocking=non_blocking | tags= | evidence,exceptions_non_blocking,lint"];
    "node.link_audit_lychee" [class="node kind-linter bucket-quality_checks blocking-conditional domain-lint domain-docs_publish domain-exceptions_non_blocking", color="#B45309", fillcolor="#FFF7E6", fontcolor="#7C2D12", id="node.link_audit_lychee", label="Link audit (lychee,\noptional)", penwidth="1.5", peripheries="1", shape="box", style="rounded,filled", tooltip="Link audit (lychee, optional) [node.link_audit_lychee] | kind=linter | blocking=conditional | tags= | docs_publish,exceptions_non_blocking,lint"];
  }
  subgraph cluster_artifacts {
    graph [color="#CBD5E1", fillcolor="#F8FAFC", fontcolor="#334155", fontsize="12", label="Artifacts / Registries / Outputs", style="rounded,filled"];
    rank="sink";
    "artifact.generated_next_session_md" [class="artifact kind-generated_doc canonicality-generated domain-generate domain-docs_publish domain-evidence", color="#6D28D9", fillcolor="#FFFFFF", fontcolor="#4C1D95", id="artifact.generated_next_session_md", label="Generated NEXT_SESSION View", penwidth="1.1", shape="note", style="dashed,filled", tooltip="Generated NEXT_SESSION View [artifact.generated_next_session_md] | path=docs/generated/control/NEXT_SESSION.md"];
    "artifact.generated_traceability_md" [class="artifact kind-generated_doc canonicality-generated domain-generate domain-docs_publish domain-traceability", color="#6D28D9", fillcolor="#FFFFFF", fontcolor="#4C1D95", id="artifact.generated_traceability_md", label="Generated Traceability View", penwidth="1.1", shape="note", style="dashed,filled", tooltip="Generated Traceability View [artifact.generated_traceability_md] | path=docs/generated/control/TRACEABILITY_SUMMARY.md"];
    "artifact.markdownlint_backlog_summary_json" [class="artifact kind-log canonicality-observed domain-lint domain-exceptions_non_blocking domain-log domain-evidence", color="#0891B2", fillcolor="#ECFEFF", fontcolor="#164E63", id="artifact.markdownlint_backlog_summary_json", label="Markdownlint backlog summary", penwidth="1.1", shape="note", style="filled", tooltip="Markdownlint backlog summary [artifact.markdownlint_backlog_summary_json] | path=logs/verify/markdownlint_backlog_summary.json"];
    "artifact.vale_backlog_summary_json" [class="artifact kind-log canonicality-observed domain-lint domain-exceptions_non_blocking domain-log domain-evidence", color="#0891B2", fillcolor="#ECFEFF", fontcolor="#164E63", id="artifact.vale_backlog_summary_json", label="Vale backlog summary", penwidth="1.1", shape="note", style="filled", tooltip="Vale backlog summary [artifact.vale_backlog_summary_json] | path=logs/verify/vale_backlog_summary.json"];
    "artifact.workflow_control_plane_full_md" [class="artifact kind-generated_doc canonicality-generated domain-generate domain-docs_publish domain-manual_review", color="#6D28D9", fillcolor="#FFFFFF", fontcolor="#4C1D95", id="artifact.workflow_control_plane_full_md", label="Workflow control plane full\nview", penwidth="1.1", shape="note", style="dashed,filled", tooltip="Workflow control plane full view [artifact.workflow_control_plane_full_md] | path=docs/generated/control/WORKFLOW_CONTROL_PLANE.md"];
