digraph "view.verify_test_flow" {
  rankdir=LR;
  graph [bgcolor="#FFFFFF", compound="true", concentrate="true", fontname="Arial", forcelabels="true", label="Verify + test flow", labeljust="l", labelloc="t", newrank="true", nodesep="0.5", ordering="out", outputorder="edgesfirst", overlap="false", pad="0.25", ranksep="0.8", splines="polyline", tooltip="Focused local verify runtime path from pre-commit into blocking docs/test checks and verify run logging, excluding CI fanout and backlog branches."];
  node [color="#6B7280", fillcolor="#FFFFFF", fontcolor="#111827", fontname="Arial", fontsize="10", margin="0.10,0.06", penwidth="1.2", shape="box", style="rounded,filled"];
  edge [arrowsize="0.7", color="#64748B", fontcolor="#475569", fontname="Arial", fontsize="9", penwidth="1.1"];
  subgraph cluster_actors {
    graph [color="#CBD5E1", fillcolor="#F8FAFC", fontcolor="#334155", fontsize="12", label="Actors", style="rounded,filled"];
    rank="same";
    "actor.user" [class="actor kind- human domain-update domain-manual_review", color="#64748B", fillcolor="#F8FAFC", fontcolor="#0F172A", id="actor.user", label="User", margin="0.12,0.07", penwidth="1.4", shape="hexagon", style="filled", tooltip="User [actor.user]"];
  }
  subgraph cluster_nodes_entry_and_hooks {
    graph [color="#C7D2FE", fillcolor="#F5F3FF", fontcolor="#334155", fontsize="12", label="Entry + Hooks", style="rounded,filled"];
    "node.pre_commit_enforcement" [class="node kind-hook bucket-entry_and_hooks blocking-blocking domain-hooks domain-validate domain-lint", color="#4338CA", fillcolor="#EEF2FF", fontcolor="#312E81", id="node.pre_commit_enforcement", label="pre-commit enforcement", penwidth="1.9", peripheries="2", shape="tab", style="rounded,filled", tooltip="pre-commit enforcement [node.pre_commit_enforcement] | kind=hook | blocking=blocking | tags= | hooks,lint,validate"];
  }
  subgraph cluster_nodes_orchestration_and_guards {
    graph [color="#BFDBFE", fillcolor="#EFF6FF", fontcolor="#334155", fontsize="12", label="Orchestration + Guards", style="rounded,filled"];
    "node.verify_fast_orchestrator" [class="node kind-script bucket-orchestration_and_guards blocking-blocking domain-validate domain-lint domain-test", color="#1D4ED8", fillcolor="#E8F1FF", fontcolor="#1E3A8A", id="node.verify_fast_orchestrator", label="verify_fast / verify_stage", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="verify_fast / verify_stage [node.verify_fast_orchestrator] | kind=script | blocking=blocking | tags= | lint,test,validate"];
    "node.mkdocs_strict" [class="node kind-validator bucket-orchestration_and_guards blocking-blocking domain-docs_publish domain-validate", color="#6D28D9", fillcolor="#F5F3FF", fontcolor="#4C1D95", id="node.mkdocs_strict", label="mkdocs build --strict", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="mkdocs build --strict [node.mkdocs_strict] | kind=validator | blocking=blocking | tags= | docs_publish,validate"];
    "node.manual_review_freeze" [class="node kind-decision bucket-orchestration_and_guards blocking-conditional domain-manual_review domain-update", color="#BE123C", fillcolor="#FFF1F2", fontcolor="#881337", id="node.manual_review_freeze", label="Manual review / freeze", penwidth="1.5", peripheries="1", shape="diamond", style="filled", tooltip="Manual review / freeze [node.manual_review_freeze] | kind=decision | blocking=conditional | tags= | manual_review,update"];
  }
  subgraph cluster_nodes_quality_checks {
    graph [color="#FDE68A", fillcolor="#FFFBEB", fontcolor="#334155", fontsize="12", label="Quality Checks", style="rounded,filled"];
    "node.markdownlint_blocking" [class="node kind-linter bucket-quality_checks blocking-blocking domain-lint domain-docs_publish domain-validate", color="#B45309", fillcolor="#FFF7E6", fontcolor="#7C2D12", id="node.markdownlint_blocking", label="markdownlint blocking", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="markdownlint blocking [node.markdownlint_blocking] | kind=linter | blocking=blocking | tags= | docs_publish,lint,validate"];
    "node.vale_blocking" [class="node kind-linter bucket-quality_checks blocking-blocking domain-lint domain-docs_publish", color="#B45309", fillcolor="#FFF7E6", fontcolor="#7C2D12", id="node.vale_blocking", label="Vale blocking", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="Vale blocking [node.vale_blocking] | kind=linter | blocking=blocking | tags= | docs_publish,lint"];
    "node.link_audit_lychee" [class="node kind-linter bucket-quality_checks blocking-conditional domain-lint domain-docs_publish domain-exceptions_non_blocking", color="#B45309", fillcolor="#FFF7E6", fontcolor="#7C2D12", id="node.link_audit_lychee", label="Link audit (lychee,\noptional)", penwidth="1.5", peripheries="1", shape="box", style="rounded,filled", tooltip="Link audit (lychee, optional) [node.link_audit_lychee] | kind=linter | blocking=conditional | tags= | docs_publish,exceptions_non_blocking,lint"];
    "node.node_check_svelte" [class="node kind-test bucket-quality_checks blocking-blocking domain-test domain-validate", color="#15803D", fillcolor="#ECFDF3", fontcolor="#14532D", id="node.node_check_svelte", label="Node check (svelte-check)", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="Node check (svelte-check) [node.node_check_svelte] | kind=test | blocking=blocking | tags= | test,validate"];
    "node.rust_fmt_check" [class="node kind-test bucket-quality_checks blocking-blocking domain-test domain-validate", color="#15803D", fillcolor="#ECFDF3", fontcolor="#14532D", id="node.rust_fmt_check", label="Rust fmt check", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="Rust fmt check [node.rust_fmt_check] | kind=test | blocking=blocking | tags= | test,validate"];
    "node.rust_clippy" [class="node kind-linter bucket-quality_checks blocking-blocking domain-lint domain-test domain-validate", color="#B45309", fillcolor="#FFF7E6", fontcolor="#7C2D12", id="node.rust_clippy", label="Rust clippy", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="Rust clippy [node.rust_clippy] | kind=linter | blocking=blocking | tags= | lint,test,validate"];
  }
  subgraph cluster_nodes_evidence_and_logs {
    graph [color="#A5F3FC", fillcolor="#ECFEFF", fontcolor="#334155", fontsize="12", label="Logging + Evidence Sinks", style="rounded,filled"];
    "node.log_verify_run" [class="node kind-log_sink bucket-evidence_and_logs blocking-blocking domain-log domain-evidence", color="#0891B2", fillcolor="#ECFEFF", fontcolor="#164E63", id="node.log_verify_run", label="log_verify_run", penwidth="1.9", peripheries="2", shape="cylinder", style="filled", tooltip="log_verify_run [node.log_verify_run] | kind=log_sink | blocking=blocking | tags= | evidence,log"];
  }
  subgraph cluster_artifacts {
    graph [color="#CBD5E1", fillcolor="#F8FAFC", fontcolor="#334155", fontsize="12", label="Artifacts / Registries / Outputs", style="rounded,filled"];
    rank="sink";
    "artifact.verify_runs_json" [class="artifact kind-evidence canonicality-canonical domain-log domain-evidence", color="#0891B2", fillcolor="#ECFEFF", fontcolor="#164E63", id="artifact.verify_runs_json", label="Verify Runs Evidence Log", penwidth="1.4", shape="note", style="filled", tooltip="Verify Runs Evidence Log [artifact.verify_runs_json] | path=docs_control/verify_runs.json"];
  }
  "node.verify_fast_orchestrator" -> "node.log_verify_run" [arrowhead="normal", class="edge relation- logs_to condition- on_fail blocking- blocks_progress evidence-required", color="#B91C1C", constraint="false", fontcolor="#991B1B", id="edge.verify_fast.on_fail.log_verify_run", minlen="1", penwidth="2.2", style="bold", tooltip="edge.verify_fast.on_fail.log_verify_run | on fail / logs to | blocking=blocks_progress", weight="0", xlabel="on fail / logs to"];
  "node.verify_fast_orchestrator" -> "node.manual_review_freeze" [arrowhead="normal", class="edge relation- feeds condition- on_skip blocking- none evidence-required", color="#D97706", constraint="false", fontcolor="#475569", id="edge.verify_fast.on_skip.manual_review", minlen="2", penwidth="1.1", style="dashed", tooltip="edge.verify_fast.on_skip.manual_review | on skip / feeds | blocking=none", weight="0", xlabel="on skip / feeds"];
  "node.verify_fast_orchestrator" -> "node.log_verify_run" [arrowhead="normal", class="edge relation- logs_to condition- on_pass blocking- none evidence-required", color="#0891B2", constraint="false", fontcolor="#475569", id="edge.verify_fast.on_pass.log_verify_run", minlen="1", penwidth="1.1", style="dotted", tooltip="edge.verify_fast.on_pass.log_verify_run | on pass / logs to | blocking=none", weight="0", xlabel="on pass / logs to"];
  "node.log_verify_run" -> "artifact.verify_runs_json" [arrowhead="normal", class="edge relation- writes condition- always blocking- none evidence-required", color="#0F766E", constraint="false", fontcolor="#475569", id="edge.log_verify_run.writes.verify_runs", minlen="1", penwidth="1.1", style="dashed", tooltip="edge.log_verify_run.writes.verify_runs | always / writes | blocking=none", weight="0", xlabel="writes"];
  "actor.user" -> "node.pre_commit_enforcement" [arrowhead="normal", class="edge relation- triggers condition- if_changed blocking- blocks_progress", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.user.triggers.pre_commit", minlen="1", penwidth="2.2", style="dashed", tooltip="edge.user.triggers.pre_commit | if changed / triggers | blocking=blocks_progress", weight="3", xlabel="if changed / triggers"];
  "node.pre_commit_enforcement" -> "node.verify_fast_orchestrator" [arrowhead="normal", class="edge relation- triggers condition- on_pass blocking- blocks_progress", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.pre_commit.on_pass.verify_fast", minlen="1", penwidth="2.2", style="solid", tooltip="edge.pre_commit.on_pass.verify_fast | on pass / triggers | blocking=blocks_progress", weight="7", xlabel="on pass / triggers"];
  "node.markdownlint_blocking" -> "node.vale_blocking" [arrowhead="normal", class="edge relation- triggers condition- on_pass blocking- blocks_progress", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.markdownlint_blocking.on_pass.vale_blocking", minlen="1", penwidth="2.2", style="solid", tooltip="edge.markdownlint_blocking.on_pass.vale_blocking | on pass / triggers | blocking=blocks_progress", weight="7", xlabel="on pass / triggers"];
  "node.vale_blocking" -> "node.mkdocs_strict" [arrowhead="normal", class="edge relation- triggers condition- on_pass blocking- blocks_progress", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.vale_blocking.on_pass.mkdocs_strict", minlen="1", penwidth="2.2", style="solid", tooltip="edge.vale_blocking.on_pass.mkdocs_strict | on pass / triggers | blocking=blocks_progress", weight="7", xlabel="on pass / triggers"];
  "node.mkdocs_strict" -> "node.log_verify_run" [arrowhead="normal", class="edge relation- logs_to condition- on_pass blocking- none evidence-required", color="#0891B2", constraint="false", fontcolor="#475569", id="edge.mkdocs_strict.on_pass.log_verify_run", minlen="1", penwidth="1.1", style="dotted", tooltip="edge.mkdocs_strict.on_pass.log_verify_run | on pass / logs to | blocking=none", weight="0", xlabel="on pass / logs to"];
  "node.link_audit_lychee" -> "node.mkdocs_strict" [arrowhead="normal", class="edge relation- triggers condition- on_pass blocking- blocks_progress", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.link_audit_lychee.on_pass.mkdocs_strict", minlen="1", penwidth="2.2", style="solid", tooltip="edge.link_audit_lychee.on_pass.mkdocs_strict | on pass / triggers | blocking=blocks_progress", weight="7", xlabel="on pass / triggers"];
  "node.link_audit_lychee" -> "node.mkdocs_strict" [arrowhead="normal", class="edge relation- triggers condition- on_skip blocking- none", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.link_audit_lychee.on_skip.mkdocs_strict", minlen="1", penwidth="1.6", style="dashed", tooltip="edge.link_audit_lychee.on_skip.mkdocs_strict | on skip / triggers | blocking=none", weight="6", xlabel="on skip / triggers"];
  "node.mkdocs_strict" -> "node.node_check_svelte" [arrowhead="normal", class="edge relation- triggers condition- on_pass blocking- blocks_progress", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.mkdocs_strict.on_pass.node_check_svelte", minlen="1", penwidth="2.2", style="solid", tooltip="edge.mkdocs_strict.on_pass.node_check_svelte | on pass / triggers | blocking=blocks_progress", weight="7", xlabel="on pass / triggers"];
  "node.node_check_svelte" -> "node.rust_fmt_check" [arrowhead="normal", class="edge relation- triggers condition- on_pass blocking- blocks_progress", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.node_check_svelte.on_pass.rust_fmt_check", minlen="1", penwidth="2.2", style="solid", tooltip="edge.node_check_svelte.on_pass.rust_fmt_check | on pass / triggers | blocking=blocks_progress", weight="7", xlabel="on pass / triggers"];
  "node.rust_fmt_check" -> "node.rust_clippy" [arrowhead="normal", class="edge relation- triggers condition- on_pass blocking- blocks_progress", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.rust_fmt_check.on_pass.rust_clippy", minlen="1", penwidth="2.2", style="solid", tooltip="edge.rust_fmt_check.on_pass.rust_clippy | on pass / triggers | blocking=blocks_progress", weight="7", xlabel="on pass / triggers"];
  "node.rust_clippy" -> "node.log_verify_run" [arrowhead="normal", class="edge relation- logs_to condition- on_pass blocking- none evidence-required", color="#0891B2", constraint="false", fontcolor="#475569", id="edge.rust_clippy.on_pass.log_verify_run", minlen="1", penwidth="1.1", style="dotted", tooltip="edge.rust_clippy.on_pass.log_verify_run | on pass / logs to | blocking=none", weight="0", xlabel="on pass / logs to"];
}
