digraph "view.hooks_ci_enforcement" {
  rankdir=TB;
  graph [bgcolor="#FFFFFF", compound="true", concentrate="true", fontname="Arial", forcelabels="true", label="Hooks + CI enforcement", labeljust="l", labelloc="t", newrank="true", nodesep="0.5", ordering="out", outputorder="edgesfirst", overlap="false", pad="0.25", ranksep="0.8", splines="polyline", tooltip="Entry-point and enforcement fanout view from local pre-commit and CI jobs into shared docs lint and code-audit check paths."];
  node [color="#6B7280", fillcolor="#FFFFFF", fontcolor="#111827", fontname="Arial", fontsize="10", margin="0.10,0.06", penwidth="1.2", shape="box", style="rounded,filled"];
  edge [arrowsize="0.7", color="#64748B", fontcolor="#475569", fontname="Arial", fontsize="9", penwidth="1.1"];
  subgraph cluster_actors {
    graph [color="#CBD5E1", fillcolor="#F8FAFC", fontcolor="#334155", fontsize="12", label="Actors", style="rounded,filled"];
    rank="source";
    "actor.user" [class="actor kind- human domain-update domain-manual_review", color="#64748B", fillcolor="#F8FAFC", fontcolor="#0F172A", id="actor.user", label="User", margin="0.12,0.07", penwidth="1.4", shape="hexagon", style="filled", tooltip="User [actor.user]"];
    "actor.ci" [class="actor kind- ci_runner domain-ci domain-validate domain-lint domain-test domain-docs_publish", color="#64748B", fillcolor="#F8FAFC", fontcolor="#0F172A", id="actor.ci", label="CI Runner", margin="0.12,0.07", penwidth="1.4", shape="hexagon", style="filled", tooltip="CI Runner [actor.ci]"];
  }
  subgraph cluster_nodes_entry_and_hooks {
    graph [color="#C7D2FE", fillcolor="#F5F3FF", fontcolor="#334155", fontsize="12", label="Entry + Hooks", style="rounded,filled"];
    "node.pre_commit_enforcement" [class="node kind-hook bucket-entry_and_hooks blocking-blocking domain-hooks domain-validate domain-lint", color="#4338CA", fillcolor="#EEF2FF", fontcolor="#312E81", id="node.pre_commit_enforcement", label="pre-commit enforcement", penwidth="1.9", peripheries="2", shape="tab", style="rounded,filled", tooltip="pre-commit enforcement [node.pre_commit_enforcement] | kind=hook | blocking=blocking | tags= | hooks,lint,validate"];
  }
  subgraph cluster_nodes_orchestration_and_guards {
    graph [color="#BFDBFE", fillcolor="#EFF6FF", fontcolor="#334155", fontsize="12", label="Orchestration + Guards", style="rounded,filled"];
    "node.verify_fast_orchestrator" [class="node kind-script bucket-orchestration_and_guards blocking-blocking domain-validate domain-lint domain-test", color="#1D4ED8", fillcolor="#E8F1FF", fontcolor="#1E3A8A", id="node.verify_fast_orchestrator", label="verify_fast / verify_stage", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="verify_fast / verify_stage [node.verify_fast_orchestrator] | kind=script | blocking=blocking | tags= | lint,test,validate"];
  }
  subgraph cluster_nodes_quality_checks {
    graph [color="#FDE68A", fillcolor="#FFFBEB", fontcolor="#334155", fontsize="12", label="Quality Checks", style="rounded,filled"];
    "node.markdownlint_blocking" [class="node kind-linter bucket-quality_checks blocking-blocking domain-lint domain-docs_publish domain-validate", color="#B45309", fillcolor="#FFF7E6", fontcolor="#7C2D12", id="node.markdownlint_blocking", label="markdownlint blocking", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="markdownlint blocking [node.markdownlint_blocking] | kind=linter | blocking=blocking | tags= | docs_publish,lint,validate"];
    "node.vale_blocking" [class="node kind-linter bucket-quality_checks blocking-blocking domain-lint domain-docs_publish", color="#B45309", fillcolor="#FFF7E6", fontcolor="#7C2D12", id="node.vale_blocking", label="Vale blocking", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="Vale blocking [node.vale_blocking] | kind=linter | blocking=blocking | tags= | docs_publish,lint"];
    "node.node_check_svelte" [class="node kind-test bucket-quality_checks blocking-blocking domain-test domain-validate", color="#15803D", fillcolor="#ECFDF3", fontcolor="#14532D", id="node.node_check_svelte", label="Node check (svelte-check)", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="Node check (svelte-check) [node.node_check_svelte] | kind=test | blocking=blocking | tags= | test,validate"];
