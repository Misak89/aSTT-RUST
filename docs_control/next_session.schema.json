{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs_control/next_session.schema.json",
  "title": "NEXT_SESSION Control Data (Hybrid-Strong)",
  "type": "object",
  "required": [
    "schema_version",
    "source_of_truth",
    "document",
    "lifecycle_state",
    "state_realization",
    "current_context",
    "next_steps",
    "workflow_alignment_checkpoint",
    "evidence_policy",
    "evidence",
    "traceability_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "source_of_truth": {
      "type": "string"
    },
    "document": {
      "type": "object",
      "required": [
        "title",
        "path",
        "version",
        "created_at",
        "updated_at",
        "status_text"
      ],
      "properties": {
        "title": { "type": "string" },
        "path": { "type": "string" },
        "version": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "status_text": { "type": "string" }
      },
      "additionalProperties": true
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "NEPROVEDENO",
        "ROZPRACOVANE",
        "PLANNED",
        "IMPLEMENTED",
        "HOTOVO",
        "DOKONCENO"
      ]
    },
    "state_realization": {
      "type": "object",
      "required": [
        "neprovedeno",
        "rozpracovane",
        "provedeno",
        "poznamka"
      ],
      "properties": {
        "neprovedeno": {
          "type": "array",
          "items": { "$ref": "#/$defs/workItem" }
        },
        "rozpracovane": {
          "type": "array",
          "items": { "$ref": "#/$defs/workItem" }
        },
        "provedeno": {
          "type": "array",
          "items": { "$ref": "#/$defs/workItem" }
        },
        "poznamka": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "current_context": {
      "type": "object",
      "required": [
        "summary",
        "hotovo",
        "kriticky_problem"
      ],
      "properties": {
        "summary": { "type": "string" },
        "hotovo": {
          "type": "array",
          "items": { "type": "string" }
        },
        "kriticky_problem": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "next_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "title",
          "priority",
          "actions"
        ],
        "properties": {
          "step_id": { "type": "string" },
          "title": { "type": "string" },
          "priority": { "type": "string" },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "acceptance": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "workflow_alignment_checkpoint": {
      "type": "object",
      "required": [
        "hook",
        "ci",
        "docs"
      ],
      "properties": {
        "hook": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ci": {
          "type": "array",
          "items": { "type": "string" }
        },
        "docs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "evidence_policy": {
      "type": "object",
      "required": [
        "implemented_requires"
      ],
      "properties": {
        "implemented_requires": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "kind",
          "result",
          "source"
        ],
        "properties": {
          "evidence_id": { "type": "string" },
          "kind": { "type": "string" },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "WARN",
              "INFO",
              "OBSERVED"
            ]
          },
          "source": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "traceability_refs": {
      "type": "object",
      "properties": {
        "spec_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "plan_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "task_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "code_ref_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "test_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "doc_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "log_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "workItem": {
      "type": "object",
      "required": [
        "item_id",
        "text"
      ],
      "properties": {
        "item_id": { "type": "string" },
        "text": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
