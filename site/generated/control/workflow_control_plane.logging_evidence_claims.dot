digraph "view.logging_evidence_claims" {
  rankdir=LR;
  graph [bgcolor="#FFFFFF", compound="true", concentrate="true", fontname="Arial", forcelabels="true", label="Logging + evidence claims", labeljust="l", labelloc="t", newrank="true", nodesep="0.5", ordering="out", outputorder="edgesfirst", overlap="false", pad="0.25", ranksep="0.8", splines="polyline", tooltip="Focused claim=evidence and evidence logging path around capability audit, preflight discovery, batch claim verification, traceability/session validators, and verify run logging."];
  node [color="#6B7280", fillcolor="#FFFFFF", fontcolor="#111827", fontname="Arial", fontsize="10", margin="0.10,0.06", penwidth="1.2", shape="box", style="rounded,filled"];
  edge [arrowsize="0.7", color="#64748B", fontcolor="#475569", fontname="Arial", fontsize="9", penwidth="1.1"];
  subgraph cluster_nodes_orchestration_and_guards {
    graph [color="#BFDBFE", fillcolor="#EFF6FF", fontcolor="#334155", fontsize="12", label="Orchestration + Guards", style="rounded,filled"];
    "node.verify_fast_orchestrator" [class="node kind-script bucket-orchestration_and_guards blocking-blocking domain-validate domain-lint domain-test", color="#1D4ED8", fillcolor="#E8F1FF", fontcolor="#1E3A8A", id="node.verify_fast_orchestrator", label="verify_fast / verify_stage", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="verify_fast / verify_stage [node.verify_fast_orchestrator] | kind=script | blocking=blocking | tags= | lint,test,validate"];
    "node.validate_traceability" [class="node kind-validator bucket-orchestration_and_guards blocking-blocking domain-validate domain-traceability domain-evidence", color="#475569", fillcolor="#F1F5F9", fontcolor="#334155", id="node.validate_traceability", label="validate_traceability", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="validate_traceability [node.validate_traceability] | kind=validator | blocking=blocking | tags= | evidence,traceability,validate"];
    "node.validate_next_session" [class="node kind-validator bucket-orchestration_and_guards blocking-blocking domain-validate domain-manual_review domain-evidence", color="#1D4ED8", fillcolor="#E8F1FF", fontcolor="#1E3A8A", id="node.validate_next_session", label="validate_next_session\nJSON-first", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="validate_next_session JSON-first [node.validate_next_session] | kind=validator | blocking=blocking | tags= | evidence,manual_review,validate"];
    "node.manual_review_freeze" [class="node kind-decision bucket-orchestration_and_guards blocking-conditional domain-manual_review domain-update", color="#BE123C", fillcolor="#FFF1F2", fontcolor="#881337", id="node.manual_review_freeze", label="Manual review / freeze", penwidth="1.5", peripheries="1", shape="diamond", style="filled", tooltip="Manual review / freeze [node.manual_review_freeze] | kind=decision | blocking=conditional | tags= | manual_review,update"];
    "node.validate_capability_audit" [class="node kind-validator bucket-orchestration_and_guards blocking-blocking domain-validate domain-log domain-evidence domain-manual_review", color="#1D4ED8", fillcolor="#E8F1FF", fontcolor="#1E3A8A", id="node.validate_capability_audit", label="validate_capability_audit\n(tools + sources)", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="validate_capability_audit (tools + sources) [node.validate_capability_audit] | kind=validator | blocking=blocking | tags= | evidence,log,manual_review,validate"];
    "node.preflight_state_discovery" [class="node kind-validator bucket-orchestration_and_guards blocking-blocking domain-validate domain-log domain-evidence domain-manual_review domain-update", color="#1D4ED8", fillcolor="#E8F1FF", fontcolor="#1E3A8A", id="node.preflight_state_discovery", label="preflight_state_discovery\n(claim=evidence)", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="preflight_state_discovery (claim=evidence) [node.preflight_state_discovery] | kind=validator | blocking=blocking | tags= | evidence,log,manual_review,update,validate"];
    "node.verify_batch_status_claims" [class="node kind-validator bucket-orchestration_and_guards blocking-blocking domain-validate domain-log domain-evidence domain-manual_review", color="#1D4ED8", fillcolor="#E8F1FF", fontcolor="#1E3A8A", id="node.verify_batch_status_claims", label="verify_batch_status claims\n(claim=evidence)", penwidth="1.9", peripheries="2", shape="box", style="rounded,filled", tooltip="verify_batch_status claims (claim=evidence) [node.verify_batch_status_claims] | kind=validator | blocking=blocking | tags= | evidence,log,manual_review,validate"];
    "node.enforce_next_session_flow" [class="node kind-gate bucket-orchestration_and_guards blocking-blocking domain-validate domain-manual_review domain-evidence", color="#1D4ED8", fillcolor="#E8F1FF", fontcolor="#1E3A8A", id="node.enforce_next_session_flow", label="enforce_next_session_flow", penwidth="1.9", peripheries="2", shape="octagon", style="rounded,filled", tooltip="enforce_next_session_flow [node.enforce_next_session_flow] | kind=gate | blocking=blocking | tags= | evidence,manual_review,validate"];
  }
  subgraph cluster_nodes_evidence_and_logs {
    graph [color="#A5F3FC", fillcolor="#ECFEFF", fontcolor="#334155", fontsize="12", label="Logging + Evidence Sinks", style="rounded,filled"];
    "node.log_verify_run" [class="node kind-log_sink bucket-evidence_and_logs blocking-blocking domain-log domain-evidence", color="#0891B2", fillcolor="#ECFEFF", fontcolor="#164E63", id="node.log_verify_run", label="log_verify_run", penwidth="1.9", peripheries="2", shape="cylinder", style="filled", tooltip="log_verify_run [node.log_verify_run] | kind=log_sink | blocking=blocking | tags= | evidence,log"];
  }
  subgraph cluster_artifacts {
    graph [color="#CBD5E1", fillcolor="#F8FAFC", fontcolor="#334155", fontsize="12", label="Artifacts / Registries / Outputs", style="rounded,filled"];
    rank="sink";
    "artifact.verify_runs_json" [class="artifact kind-evidence canonicality-canonical domain-log domain-evidence", color="#0891B2", fillcolor="#ECFEFF", fontcolor="#164E63", id="artifact.verify_runs_json", label="Verify Runs Evidence Log", penwidth="1.4", shape="note", style="filled", tooltip="Verify Runs Evidence Log [artifact.verify_runs_json] | path=docs_control/verify_runs.json"];
    "artifact.task_status_json" [class="artifact kind-canonical_json canonicality-canonical domain-validate domain-evidence domain-manual_review", color="#1D4ED8", fillcolor="#E8F1FF", fontcolor="#1E3A8A", id="artifact.task_status_json", label="Task Status Registry", penwidth="1.4", shape="note", style="filled", tooltip="Task Status Registry [artifact.task_status_json] | path=docs_control/task_status.json"];
    "artifact.capability_audit_json" [class="artifact kind-canonical_json canonicality-canonical domain-validate domain-manual_review domain-evidence", color="#1D4ED8", fillcolor="#E8F1FF", fontcolor="#1E3A8A", id="artifact.capability_audit_json", label="Capability Audit Registry", penwidth="1.4", shape="note", style="filled", tooltip="Capability Audit Registry [artifact.capability_audit_json] | path=docs_control/capability_audit.json"];
    "artifact.capability_audit_schema" [class="artifact kind-schema canonicality-canonical domain-validate", color="#475569", fillcolor="#F1F5F9", fontcolor="#334155", id="artifact.capability_audit_schema", label="Capability Audit Schema", penwidth="1.4", shape="note", style="filled", tooltip="Capability Audit Schema [artifact.capability_audit_schema] | path=docs_control/capability_audit.schema.json"];
    "artifact.preflight_state_json" [class="artifact kind-log canonicality-observed domain-validate domain-log domain-evidence", color="#0891B2", fillcolor="#ECFEFF", fontcolor="#164E63", id="artifact.preflight_state_json", label="Preflight state snapshot", penwidth="1.1", shape="note", style="filled", tooltip="Preflight state snapshot [artifact.preflight_state_json] | path=logs/verify/preflight_state.json"];
    "artifact.batch_status_verify_summary_json" [class="artifact kind-log canonicality-observed domain-validate domain-log domain-evidence", color="#0891B2", fillcolor="#ECFEFF", fontcolor="#164E63", id="artifact.batch_status_verify_summary_json", label="Batch status verify summary", penwidth="1.1", shape="note", style="filled", tooltip="Batch status verify summary [artifact.batch_status_verify_summary_json] | path=logs/verify/batch_status_verify_summary.json"];
    "artifact.capability_audit_summary_json" [class="artifact kind-log canonicality-observed domain-validate domain-log domain-evidence", color="#0891B2", fillcolor="#ECFEFF", fontcolor="#164E63", id="artifact.capability_audit_summary_json", label="Capability audit summary", penwidth="1.1", shape="note", style="filled", tooltip="Capability audit summary [artifact.capability_audit_summary_json] | path=logs/verify/capability_audit_summary.json"];
    "artifact.toolchain_capabilities_json" [class="artifact kind-log canonicality-observed domain-validate domain-log domain-evidence", color="#0891B2", fillcolor="#ECFEFF", fontcolor="#164E63", id="artifact.toolchain_capabilities_json", label="Toolchain capability\nobservations", penwidth="1.1", shape="note", style="filled", tooltip="Toolchain capability observations [artifact.toolchain_capabilities_json] | path=logs/verify/toolchain_capabilities.json"];
  }
  "node.verify_fast_orchestrator" -> "node.log_verify_run" [arrowhead="normal", class="edge relation- logs_to condition- on_fail blocking- blocks_progress evidence-required", color="#B91C1C", constraint="false", fontcolor="#991B1B", id="edge.verify_fast.on_fail.log_verify_run", minlen="1", penwidth="2.2", style="bold", tooltip="edge.verify_fast.on_fail.log_verify_run | on fail / logs to | blocking=blocks_progress", weight="0", xlabel="on fail / logs to"];
  "node.verify_fast_orchestrator" -> "node.manual_review_freeze" [arrowhead="normal", class="edge relation- feeds condition- on_skip blocking- none evidence-required", color="#D97706", constraint="false", fontcolor="#475569", id="edge.verify_fast.on_skip.manual_review", minlen="2", penwidth="1.1", style="dashed", tooltip="edge.verify_fast.on_skip.manual_review | on skip / feeds | blocking=none", weight="0", xlabel="on skip / feeds"];
  "node.verify_fast_orchestrator" -> "node.log_verify_run" [arrowhead="normal", class="edge relation- logs_to condition- on_pass blocking- none evidence-required", color="#0891B2", constraint="false", fontcolor="#475569", id="edge.verify_fast.on_pass.log_verify_run", minlen="1", penwidth="1.1", style="dotted", tooltip="edge.verify_fast.on_pass.log_verify_run | on pass / logs to | blocking=none", weight="0", xlabel="on pass / logs to"];
  "node.log_verify_run" -> "artifact.verify_runs_json" [arrowhead="normal", class="edge relation- writes condition- always blocking- none evidence-required", color="#0F766E", constraint="false", fontcolor="#475569", id="edge.log_verify_run.writes.verify_runs", minlen="1", penwidth="1.1", style="dashed", tooltip="edge.log_verify_run.writes.verify_runs | always / writes | blocking=none", weight="0", xlabel="writes"];
  "node.verify_fast_orchestrator" -> "node.validate_traceability" [arrowhead="normal", class="edge relation- triggers condition- on_pass blocking- blocks_progress", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.verify_fast.on_pass.validate_traceability", minlen="1", penwidth="2.2", style="solid", tooltip="edge.verify_fast.on_pass.validate_traceability | on pass / triggers | blocking=blocks_progress", weight="7", xlabel="on pass / triggers"];
  "node.validate_traceability" -> "node.validate_next_session" [arrowhead="normal", class="edge relation- triggers condition- on_pass blocking- blocks_progress", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.validate_traceability.on_pass.validate_next_session", minlen="1", penwidth="2.2", style="solid", tooltip="edge.validate_traceability.on_pass.validate_next_session | on pass / triggers | blocking=blocks_progress", weight="7", xlabel="on pass / triggers"];
  "node.validate_capability_audit" -> "artifact.capability_audit_summary_json" [arrowhead="normal", class="edge relation- writes condition- always blocking- none evidence-required", color="#0F766E", constraint="false", fontcolor="#475569", id="edge.validate_capability_audit.writes.capability_audit_summary_json", minlen="1", penwidth="1.1", style="dashed", tooltip="edge.validate_capability_audit.writes.capability_audit_summary_json | always / writes | blocking=none", weight="0", xlabel="writes"];
  "node.preflight_state_discovery" -> "artifact.preflight_state_json" [arrowhead="normal", class="edge relation- writes condition- always blocking- none evidence-required", color="#0F766E", constraint="false", fontcolor="#475569", id="edge.preflight_state_discovery.writes.preflight_state_json", minlen="1", penwidth="1.1", style="dashed", tooltip="edge.preflight_state_discovery.writes.preflight_state_json | always / writes | blocking=none", weight="0", xlabel="writes"];
  "node.validate_capability_audit" -> "artifact.toolchain_capabilities_json" [arrowhead="normal", class="edge relation- writes condition- always blocking- none evidence-required", color="#0F766E", constraint="false", fontcolor="#475569", id="edge.validate_capability_audit.writes.toolchain_capabilities_json", minlen="1", penwidth="1.1", style="dashed", tooltip="edge.validate_capability_audit.writes.toolchain_capabilities_json | always / writes | blocking=none", weight="0", xlabel="writes"];
  "node.preflight_state_discovery" -> "node.verify_batch_status_claims" [arrowhead="normal", class="edge relation- triggers condition- on_pass blocking- blocks_progress", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.preflight_state_discovery.on_pass.verify_batch_status_claims", minlen="1", penwidth="2.2", style="solid", tooltip="edge.preflight_state_discovery.on_pass.verify_batch_status_claims | on pass / triggers | blocking=blocks_progress", weight="7", xlabel="on pass / triggers"];
  "node.validate_capability_audit" -> "node.preflight_state_discovery" [arrowhead="normal", class="edge relation- triggers condition- on_pass blocking- blocks_progress", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.validate_capability_audit.on_pass.preflight_state_discovery", minlen="1", penwidth="2.2", style="solid", tooltip="edge.validate_capability_audit.on_pass.preflight_state_discovery | on pass / triggers | blocking=blocks_progress", weight="7", xlabel="on pass / triggers"];
  "node.verify_batch_status_claims" -> "artifact.batch_status_verify_summary_json" [arrowhead="normal", class="edge relation- writes condition- always blocking- none evidence-required", color="#0F766E", constraint="false", fontcolor="#475569", id="edge.verify_batch_status_claims.writes.batch_status_verify_summary_json", minlen="1", penwidth="1.1", style="dashed", tooltip="edge.verify_batch_status_claims.writes.batch_status_verify_summary_json | always / writes | blocking=none", weight="0", xlabel="writes"];
  "node.verify_batch_status_claims" -> "node.validate_traceability" [arrowhead="normal", class="edge relation- triggers condition- on_pass blocking- blocks_progress", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.verify_batch_status_claims.on_pass.validate_traceability", minlen="1", penwidth="2.2", style="solid", tooltip="edge.verify_batch_status_claims.on_pass.validate_traceability | on pass / triggers | blocking=blocks_progress", weight="7", xlabel="on pass / triggers"];
  "node.validate_next_session" -> "node.enforce_next_session_flow" [arrowhead="normal", class="edge relation- triggers condition- on_pass blocking- blocks_progress", color="#1D4ED8", constraint="true", fontcolor="#475569", id="edge.validate_next_session.on_pass.enforce_next_session_flow", minlen="1", penwidth="2.2", style="solid", tooltip="edge.validate_next_session.on_pass.enforce_next_session_flow | on pass / triggers | blocking=blocks_progress", weight="7", xlabel="on pass / triggers"];
  "node.preflight_state_discovery" -> "artifact.task_status_json" [arrowhead="vee", class="edge relation- reads condition- always blocking- none", color="#64748B", constraint="false", fontcolor="#475569", id="edge.preflight_state_discovery.reads.task_status_json", minlen="1", penwidth="1.1", style="dashed", tooltip="edge.preflight_state_discovery.reads.task_status_json | always / reads | blocking=none", weight="0", xlabel="reads"];
  "node.verify_batch_status_claims" -> "artifact.task_status_json" [arrowhead="vee", class="edge relation- reads condition- always blocking- none", color="#64748B", constraint="false", fontcolor="#475569", id="edge.verify_batch_status_claims.reads.task_status_json", minlen="1", penwidth="1.1", style="dashed", tooltip="edge.verify_batch_status_claims.reads.task_status_json | always / reads | blocking=none", weight="0", xlabel="reads"];
  "node.validate_capability_audit" -> "artifact.capability_audit_json" [arrowhead="vee", class="edge relation- reads condition- always blocking- none", color="#64748B", constraint="false", fontcolor="#475569", id="edge.validate_capability_audit.reads.capability_audit_json", minlen="1", penwidth="1.1", style="dashed", tooltip="edge.validate_capability_audit.reads.capability_audit_json | always / reads | blocking=none", weight="0", xlabel="reads"];
  "node.validate_capability_audit" -> "artifact.capability_audit_schema" [arrowhead="vee", class="edge relation- reads condition- always blocking- none", color="#64748B", constraint="false", fontcolor="#475569", id="edge.validate_capability_audit.reads.capability_audit_schema", minlen="1", penwidth="1.1", style="dashed", tooltip="edge.validate_capability_audit.reads.capability_audit_schema | always / reads | blocking=none", weight="0", xlabel="reads"];
}
